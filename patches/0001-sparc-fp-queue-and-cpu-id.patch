+// A deferred exception leaves the queue loaded. Until software drains it with
+// STDFQ, any floating-point instruction other than a load or store of the FSR
+// delivers the trap. Delivering it here calls off the countdown that would
+// otherwise deliver the same exception a few instructions later.
+bool sparc_base_device::fq_blocks()
+{
+	if (!m_fpu_exception_mode)
+		return false;
+
+	// the first one delivers the exception that is already queued; any
+	// further floating-point instruction is a sequence error
+	if (m_fpu_exception_mode == 2)
+		m_fsr = (m_fsr & ~FSR_FTT_MASK) | FSR_FTT_SEQ;
+	m_fpu_exception_mode = 2;
+
+	m_fp_exception_pending = false;
+	m_fpr_pending = 0;
+	m_pending_fpr = std::size(m_fpr);
+	m_trap = 1;
+	m_fp_exception = 1;
+	return true;
+}
